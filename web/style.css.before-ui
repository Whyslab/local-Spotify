* {
    box-sizing:border-box;
}


body {

    margin:0;
    min-height:100vh;

    background:
    radial-gradient(circle at top,#1db95433,transparent 30%),
    #090909;

    color:white;

    font-family:
    Inter,
    system-ui,
    sans-serif;

}



.container {

    max-width:1000px;

    margin:auto;

    padding:30px;

}



header {

    text-align:center;

    margin-bottom:30px;

}


header h1 {

    font-size:42px;
    margin-bottom:5px;

}


header p {

    color:#aaa;

}



.card {

    background:#151515;

    border-radius:20px;

    padding:25px;

    margin-bottom:25px;

    box-shadow:
    0 10px 30px #0008;

}



h2 {

    margin-top:0;

}



textarea {

    width:100%;

    min-height:120px;

    resize:none;

    background:#222;

    color:white;

    border:1px solid #333;

    border-radius:12px;

    padding:15px;

    font-size:15px;

}



button {

    margin-top:15px;

    background:#1ed760;

    color:black;

    border:none;

    padding:14px 30px;

    border-radius:30px;

    font-weight:bold;

    cursor:pointer;

}



button:hover {

    transform:scale(1.03);

}



.status {

    display:inline-block;

    padding:6px 12px;

    border-radius:20px;

    background:#222;

    margin:4px;

}



table {

    width:100%;

    border-collapse:collapse;

}


th {

    text-align:left;

    color:#aaa;

}



td,th {

    padding:12px;

    border-bottom:1px solid #333;

}



.done {

    color:#1ed760;

}



.error {

    color:#ff5555;

}



.downloading {

    color:#ffd166;

}



small {

    color:#888;

}



@media(max-width:700px){

.container{

padding:15px;

}

header h1{

font-size:32px;

}

.card{

padding:18px;

}

table{

font-size:12px;

}

}

#loginBox input {

width:100%;

padding:15px;

background:#222;

border:1px solid #333;

border-radius:12px;

color:white;

font-size:16px;

margin-bottom:10px;

}


#loginBox {

border:1px solid #1ed760;

}
