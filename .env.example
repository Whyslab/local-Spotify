# Пример настроек local-Spotify.
# Скопируй в adder/.env. Обязателен только API_TOKEN; остальное — значения
# по умолчанию, их можно не трогать. Изменения применяются после перезапуска:
#   systemctl --user restart music-adder

# ---------------------------------------------------------------- обязательно

# Сильный случайный токен для доступа к API и веб-интерфейсу. С пустым токеном
# или с этой заглушкой сервис не запустится.
# Сгенерировать: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ---------------------------------------------------------------- библиотека

# Путь к библиотеке (по умолчанию ~/Music/Normalized Library).
# Раскомментируй, только если библиотека лежит в другом месте, и укажи
# абсолютный путь без кавычек. Этот же путь должен быть MusicFolder в Navidrome.
# LIBRARY_PATH=/srv/music/Normalized Library

# Сохранять полные имена исполнителей с feat./ft. в имени папки (по умолчанию true)
PRESERVE_FEAT_ARTISTS=true

# ---------------------------------------------------------------- сеть

# Порт и адрес, на которых слушает сервис (по умолчанию 8787 и вся сеть)
PORT=8787
HOST=0.0.0.0

# ---------------------------------------------------------------- очередь и загрузки

# Количество параллельных загрузок (по умолчанию 2)
MAX_WORKERS=2

# Максимум ссылок в одном запросе (по умолчанию 100)
MAX_LINKS_PER_REQUEST=100

# Максимальный размер очереди задач (по умолчанию 5000)
MAX_QUEUE_SIZE=5000

# Попыток на задачу при временных ошибках — сеть, HTTP 429 (по умолчанию 3)
MAX_RETRIES=3

# База экспоненциальной паузы между попытками, секунды (по умолчанию 2.0)
RETRY_BACKOFF_BASE=2.0

# Пауза после ограничения от YouTube (HTTP 429 / «try again later»), секунд на попытку:
# 60, 120, ... Всё это время не запускается ни один вызов yt-dlp (по умолчанию 60)
RATE_LIMIT_BACKOFF=60

# Самое длинное видео, которое принимается, в минутах; 0 — без ограничения (по умолчанию 30).
# Прямые эфиры не принимаются никогда.
MAX_DURATION_MINUTES=30

# Минимум свободного места на диске в МБ — и для временных файлов, и для
# библиотеки (по умолчанию 2048)
MIN_FREE_SPACE_MB=2048

# Через сколько часов удаляются зависшие временные файлы (по умолчанию 24)
TMP_TTL_HOURS=24

# Сколько секунд ждать завершения загрузок при остановке (по умолчанию 30).
# install.sh даёт systemd на 15 секунд больше.
SHUTDOWN_TIMEOUT=30

# Откуда yt-dlp берёт cookies. Нужно, только если YouTube отвечает
# «Sign in to confirm you're not a bot»: cookies браузера, где выполнен вход
# в YouTube, проходят эту проверку. Синтаксис yt-dlp: "firefox", "chrome"
# или "firefox:/путь/к/профилю", если профиль лежит не на обычном месте.
COOKIES_FROM_BROWSER=

# ---------------------------------------------------------------- Navidrome (необязательно)

# Нужен для обложек подборок и чтобы убирать подборку из Navidrome, когда её
# .m3u удалён — сам он этого не замечает. Без этих строк сервис работает,
# а эта часть ждёт в очереди, пока они не появятся.
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Максимальный размер загружаемой обложки подборки, байты (по умолчанию 8 МБ)
# MAX_COVER_BYTES=8388608

# Сколько дней хранится журнал прослушиваний (по умолчанию 400)
# PLAY_HISTORY_DAYS=400

# ---------------------------------------------------------------- офлайн-скрипты

# Пауза между треками в adder/fix_covers.py — защита от ограничений iTunes.
# Сервис её не использует (по умолчанию 1.1 секунды)
DELAY_BETWEEN_TRACKS=1.1
