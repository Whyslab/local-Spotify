# Пример конфигурации для youtube_to_navidrome/adder
# Скопируй в .env и заполни своими данными

# Путь к библиотеке (по умолчанию ~/Music/Normalized Library)
LIBRARY_PATH=/home/bogdan/Music/Normalized Library

# Порт веб-интерфейса (по умолчанию 8787)
PORT=8787

# Количество параллельных воркеров (по умолчанию 2)
MAX_WORKERS=2
