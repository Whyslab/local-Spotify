# Пример конфигурации для local-Spotify/adder
# Скопируй в adder/.env и заполни своими данными.

# Путь к библиотеке (по умолчанию ~/Music/Normalized Library)
LIBRARY_PATH=/home/your-user/Music/Normalized Library

# Порт веб-интерфейса (по умолчанию 8787)
PORT=8787

# Host для LAN-доступа
HOST=0.0.0.0

# Количество параллельных воркеров (по умолчанию 2)
MAX_WORKERS=2

# Пауза между треками при миграции плейлистов (по умолчанию 1.1 секунды)
DELAY_BETWEEN_TRACKS=1.1

# Максимум ссылок в одном запросе (по умолчанию 100)
MAX_LINKS_PER_REQUEST=100

# Максимальный размер очереди задач (по умолчанию 5000)
MAX_QUEUE_SIZE=5000

# Сохранять полные имена исполнителей с feat./ft. (по умолчанию true)
PRESERVE_FEAT_ARTISTS=true

# ОБЯЗАТЕЛЬНО: сильный случайный токен для доступа к API.
# Сгенерировать: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Максимум попыток повтора для transient ошибок (по умолчанию 3)
MAX_RETRIES=3

# База экспоненциального backoff в секундах (по умолчанию 2.0)
RETRY_BACKOFF_BASE=2.0

# Таймаут graceful shutdown в секундах (по умолчанию 30)
SHUTDOWN_TIMEOUT=30

# Минимум свободного места на диске в MB (по умолчанию 2048)
MIN_FREE_SPACE_MB=2048

# Время жизни временных файлов в часах (по умолчанию 24)
TMP_TTL_HOURS=24

# Optional: where yt-dlp should read cookies from.
# YouTube sometimes refuses a download as suspected bot traffic; a logged-in
# browser's cookies satisfy that check. yt-dlp's own syntax: "firefox",
# "chrome", or "firefox:/path/to/profile" when the profile is not in the
# default location.
COOKIES_FROM_BROWSER=

# Navidrome (optional). Needed for playlist covers and for removing a playlist
# from Navidrome when its .m3u is deleted -- it does not notice on its own.
# Without these the service runs normally and queues that work until they appear.
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
