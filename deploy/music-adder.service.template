[Unit]
Description=YouTube to Navidrome adder
[Service]
ExecStart=%REPO%/adder/.venv/bin/python %REPO%/adder/app.py
Restart=on-failure

# Problem #16: Systemd hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

# Allow write access to library and project directories
ReadWritePaths=%REPO%
ReadWritePaths=/home/bogdan/Music/Normalized Library

# Graceful shutdown (Problem #22)
TimeoutStopSec=30

[Install]
WantedBy=default.target
