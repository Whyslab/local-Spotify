[Unit]
Description=YouTube to Navidrome adder

[Service]
WorkingDirectory=%REPO%
ExecStart=%REPO%/.venv/bin/python -m adder.server
Restart=on-failure

# Send SIGTERM to the main process only. The workers terminate their own
# yt-dlp/ffmpeg children via os.killpg (see terminate_process in adder/app.py),
# so letting systemd signal the whole cgroup would kill those subprocesses
# out from under the shutdown path instead of through it.
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

# The installer replaces %LIBRARY% with the configured library path.
# Scoped to adder/ (holds adder.db and tmp/) rather than the whole repo,
# so the service can't write to its own source, the web/ frontend it
# serves, deploy/ scripts, or .git even if it were ever tricked into an
# arbitrary file write.
ReadWritePaths=%REPO%/adder
ReadWritePaths="%LIBRARY%"

TimeoutStopSec=30

[Install]
WantedBy=default.target
