[Unit]
Description=YouTube to Navidrome adder

[Service]
WorkingDirectory=%REPO%
ExecStart=%REPO%/.venv/bin/python -m adder.server
Restart=on-failure

# Send SIGTERM to the main process only. The workers terminate their own
# yt-dlp/ffmpeg children via os.killpg (see terminate_process in adder/app.py),
# so letting systemd signal the whole cgroup would kill those subprocesses
# out from under the shutdown path instead of through it.
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectSystem=strict mounts / read-only but does NOT cover /home, which is a
# separate mount point: without ProtectHome the service could still write to its
# own source tree. ProtectHome=read-only closes that, and every directory the
# service legitimately writes to must then be listed in ReadWritePaths below --
# including trash/, which lives at the repository root rather than under adder/.
# Verified with systemd-run --user: without ReadWritePaths for trash/, deleting a
# track fails silently.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

# The installer replaces %LIBRARY% with the configured library path.
# Scoped to adder/ (adder.db and tmp/) and trash/ (deleted tracks) rather than
# the whole repo, so the service can't write to its own source, the web/
# frontend it serves, deploy/ scripts, or .git even if it were ever tricked
# into an arbitrary file write. This only holds because ProtectHome=read-only
# is set above; ProtectSystem=strict alone leaves /home writable.
ReadWritePaths=%REPO%/adder
ReadWritePaths=%REPO%/trash
ReadWritePaths="%LIBRARY%"

TimeoutStopSec=30

[Install]
WantedBy=default.target
