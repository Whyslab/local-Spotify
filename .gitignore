# Environment variables
.env
.env.local
*.env.*

# Dependencies
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build/dist directories
build/
dist/
*.egg-info/

# Logs
*.log

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Pre-edit backup copies (e.g. app.py.backup-before-web, app.js.before-ui) -
# useful locally while editing, but not meant to be committed or served.
*backup*
*before-*

# Test tooling
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
coverage/
htmlcov/

# Python specific
*.py[cod]
*$py.class
*.so
.Python
adder/adder.db

# Runtime / migration state
*.db-shm
*.db-wal
# Personal data of the finished Spotify import (the files are gone, the
# scripts too): ignored still, so a copy restored from a backup is not committed.
links_state.db
spotify_tracks_youtube.csv
Monday.txt
missing_tracks.csv
missing_youtube.csv
missing_links.db
adder/tmp/
scripts/tmp/

# Deleted tracks land here instead of being unlinked
trash/

# Links from the Spotify import that no tag or task holds (scripts/upgrade_audio.py)
adder/known-links.csv

# graphify knowledge graph (regenerate with: graphify update .)
graphify-out/

# Runtime data: previous versions of playlists and the covers uploaded for them.
adder/playlist-history/
adder/playlist-covers/

# OMC session state, written wherever a session happens to start.
.omc/
lyrics-cache/

# Список похожих артистов от Deezer: кэш, а не исходники.
similar-cache/
adder/numba-cache/

# Треки не из фонотеки для умного перемешивания: временный кэш, чистится сам.
adder/outside-cache/
# Уменьшенные обложки для списков — кэш, собирается сам.
adder/thumb-cache/
# Картинки из Deezer (находки, фото артистов) — кэш; свои шапки артистов —
# данные, как обложки подборок, в историю не идут.
adder/web-covers/
adder/artist-photos/
# «Артист целиком»: ожидание поиска на YouTube — состояние, не исходник.
adder/artist-import.json
# yt-dlp and Deno caches (XDG_CACHE_HOME for yt-dlp calls)
adder/cache/

# Nightly consistent copies of adder.db (deploy/music-db-snapshot)
adder/snapshots/
